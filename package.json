{
  "name": "deutschmaster",
  "version": "1.1.0",
  "description": "Offline German learning for Russian-speaking learners",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:web\" \"wait-on http://127.0.0.1:5173 && node scripts/start-electron.mjs --dev\"",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit && vitest run && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "dist:win": "npm run build && electron-builder --win nsis --x64"
  },
  "keywords": [],
  "author": "DeutschMaster",
  "license": "MIT",
  "type": "module",
  "build": {
    "appId": "local.deutschmaster.app",
    "productName": "DeutschMaster",
    "asar": true,
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "node_modules/sql.js/dist/sql-wasm.js", "node_modules/sql.js/dist/sql-wasm.wasm", "package.json"],
    "asarUnpack": ["node_modules/sql.js/dist/sql-wasm.wasm"],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true, "artifactName": "DeutschMaster-Setup-${version}.${ext}" }
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sql.js": "^1.15.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wait-on": "^9.5.1"
  }
}
